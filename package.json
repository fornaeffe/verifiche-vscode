{
  "name": "verifiche-vscode",
  "displayName": "Verifiche",
  "description": "Verifiche ed esercizi Markdown/YAML nell'editor, con anteprima e PDF.",
  "version": "0.1.5",
  "publisher": "fornaeffe",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/fornaeffe/verifiche-vscode.git"
  },
  "homepage": "https://github.com/fornaeffe/verifiche-vscode#readme",
  "bugs": {
    "url": "https://github.com/fornaeffe/verifiche-vscode/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node tools/build.mjs",
    "test": "tsx --test test/*.test.ts",
    "docs:check": "node tools/check-docs.mjs",
    "test:integration": "node tools/integration.mjs",
    "cli": "tsx src/cli.ts",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "playwright": "^1.55.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "verifiche.openGuide",
        "title": "Verifiche: Apri guida"
      },
      {
        "command": "verifiche.createDataFolder",
        "title": "Verifiche: Crea cartella dati…"
      },
      {
        "command": "verifiche.insertChemicalFormula",
        "title": "Verifiche: Inserisci formula chimica",
        "enablement": "!editorReadonly && verifiche.document"
      },
      {
        "command": "verifiche.template",
        "title": "Verifiche: Inserisci template"
      },
      {
        "command": "verifiche.preview",
        "title": "Verifiche: Apri anteprima",
        "icon": "$(open-preview)"
      },
      {
        "command": "verifiche.addBlock",
        "title": "Verifiche: Inserisci blocco"
      },
      {
        "command": "verifiche.addTrace",
        "title": "Verifiche: Aggiungi traccia"
      },
      {
        "command": "verifiche.deleteTrace",
        "title": "Verifiche: Elimina traccia"
      },
      {
        "command": "verifiche.renameTrace",
        "title": "Verifiche: Rinomina traccia"
      },
      {
        "command": "verifiche.duplicateTrace",
        "title": "Verifiche: Duplica traccia"
      },
      {
        "command": "verifiche.chooseVariant",
        "title": "Verifiche: Scegli variante"
      },
      {
        "command": "verifiche.addVariant",
        "title": "Verifiche: Aggiungi variante"
      },
      {
        "command": "verifiche.duplicateVariant",
        "title": "Verifiche: Duplica variante"
      },
      {
        "command": "verifiche.renameVariant",
        "title": "Verifiche: Rinomina variante"
      },
      {
        "command": "verifiche.export",
        "title": "Verifiche: Esporta traccia PDF"
      },
      {
        "command": "verifiche.exportAll",
        "title": "Verifiche: Esporta tutti i PDF"
      },
      {
        "command": "verifiche.installBrowser",
        "title": "Verifiche: Installa Chromium per i PDF"
      },
      {
        "command": "verifiche.validate",
        "title": "Verifiche: Controlla tutti i contenuti"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "verifiche.preview",
          "when": "verifiche.document",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "verifiche.addBlock",
          "when": "verifiche.kind == verifiche",
          "group": "verifiche"
        },
        {
          "command": "verifiche.preview",
          "when": "verifiche.document",
          "group": "verifiche"
        }
      ]
    },
    "keybindings": [
      {
        "command": "verifiche.insertChemicalFormula",
        "key": "ctrl+k ctrl+alt+h",
        "mac": "cmd+k cmd+alt+h",
        "when": "editorTextFocus && !editorReadonly && verifiche.document"
      },
      {
        "command": "verifiche.addBlock",
        "key": "ctrl+alt+insert",
        "mac": "cmd+alt+insert",
        "when": "editorTextFocus && verifiche.kind == verifiche"
      }
    ],
    "configuration": {
      "title": "Verifiche",
      "properties": {
        "verifiche.contentDirectory": {
          "type": "string",
          "default": "contenuti",
          "scope": "resource",
          "description": "Cartella dei contenuti relativa alla radice del workspace."
        },
        "verifiche.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "Apri l'anteprima quando si attiva una verifica o un esercizio."
        },
        "verifiche.defaultExercisePoints": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Assegna punti: 1 agli esercizi aggiunti alla verifica tramite inserimento o trascinamento, salvo nei gruppi con un punteggio già impostato."
        },
        "verifiche.defaultVariantName": {
          "type": "string",
          "default": "base",
          "scope": "resource",
          "pattern": "^(?!(?:default|undefined|__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+$",
          "description": "Nome della prima variante nei nuovi esercizi, per tutti i template. Usare lettere, numeri, trattini o underscore; i nomi riservati non sono ammessi."
        },
        "verifiche.defaultPublicTraceId": {
          "type": "string",
          "default": "prova",
          "scope": "resource",
          "pattern": "^(?!(?:default|undefined|__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+$",
          "description": "ID della traccia pubblica nei nuovi template verifica. Deve essere diverso da Default First Trace Id. Usare lettere, numeri, trattini o underscore; i nomi riservati non sono ammessi."
        },
        "verifiche.defaultFirstTraceId": {
          "type": "string",
          "default": "1",
          "scope": "resource",
          "pattern": "^(?!(?:default|undefined|__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+$",
          "description": "ID della prima traccia ordinaria nei nuovi template verifica. Deve essere diverso da Default Public Trace Id. Le tracce aggiunte successivamente usano il primo numero libero."
        },
        "verifiche.defaultExerciseFileName": {
          "type": "string",
          "default": "nuovo-esercizio.md",
          "scope": "resource",
          "minLength": 4,
          "description": "Nome di file .md proposto nella finestra Nuovo esercizio. Usare un semplice nome valido anche su Windows, senza cartelle; la destinazione si sceglie nella finestra di salvataggio."
        },
        "verifiche.outputDirectory": {
          "type": "string",
          "default": "output",
          "scope": "resource",
          "minLength": 1,
          "description": "Cartella dei PDF: percorso relativo alla radice della cartella workspace della verifica, oppure assoluto. Sono ammessi percorsi esterni al workspace; variabili, ~ e URI non vengono espansi. Conserva le sottocartelle delle verifiche e sovrascrive i PDF omonimi."
        }
      }
    }
  }
}
